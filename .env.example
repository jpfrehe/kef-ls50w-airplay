# Copy to .env and fill in. .env is read by docker compose and by tools/render_ha.py.
# Never commit your .env (it is in .gitignore): the webhook suffix acts as a password.

# --- Network ---
# IP address of the KEF LS50 Wireless (give it a fixed DHCP lease in your router)
KEF_HOST=192.0.2.10
# Home Assistant as seen from the Docker host (both containers use host networking)
HA_URL=http://127.0.0.1:8123
# LAN interface(s) the AirPlay receiver is announced on, e.g. eth0 or eno1 (empty = all)
AVAHI_INTERFACES=eth0
# mDNS host name of the AirPlay receiver
AVAHI_HOSTNAME=kef-airplay

# --- Webhooks ---
# Random secret suffix for all webhook IDs, e.g. generated with: openssl rand -hex 12
WEBHOOK_SUFFIX=CHANGE_ME

# --- Paths on the Docker host ---
# Data directory of Music Assistant
MA_DATA_DIR=./music-assistant
# Home Assistant configuration directory (the Apple TV watcher reads .storage from it, read-only)
HA_CONFIG_DIR=./homeassistant-config

# --- AirPlay ---
# classic = AirPlay 1 (ALAC, lossless, recommended) | airplay2 = AirPlay 2 (AAC, Home app, multiroom)
SHAIRPORT_MODE=classic
# Negative = hand audio to Music Assistant earlier; compensates the KEF's ~3.7 s buffer
SHAIRPORT_LATENCY_OFFSET=-1.5

# --- Apple TV ---
# Title of the Apple TV entry in Home Assistant (Settings > Devices & services > Apple TV)
ATV_NAME=Living Room

# --- IR blaster (Moes UFO-R11 via ZHA) ---
# IEEE address of the UFO-R11 (ZHA > device > Zigbee info)
IR_IEEE=00:00:00:00:00:00:00:00
# Learned code of the KEF power key (attribute last_learned_ir_code, see README)
IR_CODE_POWER=CHANGE_ME

# --- Notifications ---
# notify entity that gets a message if the KEF cannot be woken, e.g. notify.mobile_app_my_phone
NOTIFY_ENTITY=notify.CHANGE_ME
